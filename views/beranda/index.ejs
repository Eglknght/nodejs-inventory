<!DOCTYPE html>
<html lang="id" class="h-100">
<link rel="stylesheet" href="/custom-beranda.css">    
<%- include('../layout/header') %>

<body class="d-flex min-vh-100 text-center text-bg-dark">
    <div class="cover-container d-flex w-100 min-vh-100 p-3 mx-auto flex-column">
        <header class="mb-auto">
            <div>
                <h3 class="float-md-start mb-0">Inventory Elang</h3>
                <nav class="nav nav-masthead justify-content-center float-md-end">
                    <a class="nav-link fw-bold py-1 px-0 active" aria-current="page" href="/">Beranda</a>
                    <a class="nav-link fw-bold py-1 px-0" href="/login">Login</a>
                </nav>
            </div>
        </header>

        <main class="px-3 my-5">
            <h1>Selamat datang</h1>
            <p class="lead">Inventory Adalah Aplikasi Yang Digunakan Untuk Mengelola Data Inventory</p>
            <p class="lead">
                <a href="#fitur" class="btn btn-lg btn-light fw-bold border-white bg-white">Pelajari lebih lanjut</a>
            </p>
        </main>
        <section id ="fitur" class="px-3 py-5 mt-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="bi bi-box-seam" style="font-size: 2.5rem; color: #0d6efd;"></i>
                        </div>
                        <h5 class="text-white">Kelola produk & Kategori</h5>
                        <p class="text-white-50">Tambah, edit, dan hapus produk serta kategori dengan mudah.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="bi bi-arrow-left-right" style="font-size: 2.5rem; color: #0d6efd;"></i>
                        </div>
                        <h5 class="text-white">Tracking stok Real-time</h5>
                        <p class="text-white-50">Pantau stok masuk dan keluar setiap saat secara akurat.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary h-100 text-center p-4">
                        <div class="mb-3">
                            <i class="bi bi-bar-chart-line" style="font-size: 2.5rem; color: #0d6efd;"></i>
                        </div>
                        <h5 class="text-white">Laporan & Visualisasi</h5>
                        <p class="text-white-50">Lihat laporan stok lengkap dengan grafik yang mudah dipahami.</p>
                    </div>
                </div>
            </div>
        </section>      
            
        <footer class="mt-auto text-white-50">
            <p>Dibuat dengan Javascript oleh Elang Satria Pratama</p>
        </footer>
    </div>
</body>

</html>